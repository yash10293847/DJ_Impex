# Enquiry email delivery (Nodemailer SMTP).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and a 16-character App
# Password for EMAIL_PASS.
#
# NEVER put a real value in this file. It is tracked by git and this repository
# is public. A working Gmail app password was committed here on 2026-09-22; it
# is blanked below, but blanking it does not un-leak it. The password is still
# in the repository's history and must be revoked in the Google account.
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=
#ENQUIRY_FROM_EMAIL=Nabeen Luxury Fabrics <enquiries@djimpex.in>

# Live Google reviews. Enable Places API (New), then add a server-restricted key
# and the Google Place ID for D J Impex. Never use NEXT_PUBLIC_ for this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Shows TBC tags, image placeholders and the /_todo checklist.
# Available only in development; production builds always disable it.
NEXT_PUBLIC_SHOW_TODO=false

# Admin panel: provision a fresh versioned scrypt hash with npm run security:setup.
# The generated file is ignored, and its values must be configured privately.
# Missing settings deny admin/contact access; no password fallback exists.
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=
SECURITY_SECRET=
# Exact canonical HTTPS origin, no path. Preview deployment origins use VERCEL_URL.
APP_ORIGIN=
# Optional authenticated sender when SMTP_USER is not an email address.
SMTP_FROM_EMAIL=
# Set false to pause outgoing email while still recording accepted enquiries.
CONTACT_EMAIL_ENABLED=true

# Vercel Blob, where the admin panel keeps its JSON documents and uploaded
# images in production. Set automatically by the linked "nabeen-admin-data"
# store; `vercel env pull` brings it into .env.local. Leave it unset locally and
# the panel writes real files to data/ and public/uploads instead.
BLOB_READ_WRITE_TOKEN=

# The address the site tells search engines and social platforms it lives at.
# Set this to the real domain the moment it is pointed at this deployment, e.g.
# https://www.djimpex.in. Left unset, the site uses Vercel's own production
# domain, which at least resolves. It must never name a domain that 404s: every
# canonical link, sitemap entry and share preview is built from it.
NEXT_PUBLIC_SITE_URL=
