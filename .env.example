# Configuration template only. Never commit real credentials here.
# Copy to .env.local for development; configure production values privately in Vercel.

# Site URLs: local development uses port 3001. Set your HTTPS domain on Vercel.
APP_ORIGIN=http://localhost:3001
NEXT_PUBLIC_SITE_URL=

# Admin login. Generate ADMIN_PASSWORD_HASH and SECURITY_SECRET with npm run security:setup.
# ADMIN_EMAIL is the administrator login address; keep all three values private.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SECURITY_SECRET=
# Separate 32-byte encryption key (64 hex characters) for authenticator secrets.
# Keep backed up privately; losing or changing it after enrollment blocks MFA.
MFA_ENCRYPTION_KEY=

# Enquiry email. EMAIL_USER / EMAIL_PASS are the canonical SMTP credentials.
# For Gmail, use an app password. Preserve the exact password bytes.
# SMTP_FROM_EMAIL is optional when EMAIL_USER is already an email address.
# CONTACT_EMAIL_ENABLED=false pauses email while enquiries are still recorded.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=
EMAIL_PASS=
SMTP_FROM_EMAIL=
CONTACT_RECEIVER_EMAIL=
CONTACT_EMAIL_ENABLED=true

# Optional live Google reviews. Keep the API key server-only.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Storage. Required on Vercel and in production; leave blank for local filesystem storage.
BLOB_READ_WRITE_TOKEN=

# Development checklist. Always disabled in production.
NEXT_PUBLIC_SHOW_TODO=false
